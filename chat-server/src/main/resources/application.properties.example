server.port=8888
server.servlet.context-path=/api

app.base-url=${APP_BASE_URL:http://localhost:8888}
app.frontend-url=${APP_FRONTEND_URL:http://localhost:3000}

# ===== PostgreSQL =====
spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:chat_db}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# ===== MongoDB =====
spring.data.mongodb.host=${MONGO_HOST:localhost}
spring.data.mongodb.port=${MONGO_PORT:27017}
spring.data.mongodb.database=${MONGO_DB:chat_db}
spring.data.mongodb.auto-index-creation=true

# ===== Redis =====
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}
spring.data.redis.password=${REDIS_PASSWORD}
spring.data.redis.timeout=${REDIS_TIMEOUT:2000}
spring.data.redis.connect-timeout=${REDIS_CONNECT_TIMEOUT:2000}

# ===== JWT =====
jwt.secret=${JWT_SECRET}
jwt.access-token-expiration=${JWT_ACCESS_TOKEN_EXPIRATION:900000}
jwt.refresh-token-expiration=${JWT_REFRESH_TOKEN_EXPIRATION:2592000000}

# ===== Mail =====
spring.mail.host=${MAIL_HOST:smtp.gmail.com}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME}
spring.mail.password=${MAIL_PASSWORD}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# ===== OAuth2 Google =====
spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID}
spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET}
spring.security.oauth2.client.registration.google.scope[0]=openid
spring.security.oauth2.client.registration.google.scope[1]=email
spring.security.oauth2.client.registration.google.scope[2]=profile

# ===== RabbitMQ (STOMP) =====
rabbitmq.stomp.host=${RABBITMQ_STOMP_HOST:localhost}
rabbitmq.stomp.port=${RABBITMQ_STOMP_PORT:61613}
rabbitmq.stomp.login=${RABBITMQ_STOMP_LOGIN:admin}
rabbitmq.stomp.passcode=${RABBITMQ_STOMP_PASSCODE}

# ===== Active profile (override via SPRING_PROFILES_ACTIVE env var) =====
spring.profiles.active=${SPRING_PROFILES_ACTIVE:dev}